<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="e_commerceJoias.view.LoginPages"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    BackgroundColor="White">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            FontAttributes="Bold"
            FontSize="28"
            HorizontalOptions="Center"
            Text="Bem-vindo!" />

        <Label
            FontSize="14"
            HorizontalOptions="Center"
            Text="Faça login para continuar"
            TextColor="Gray" />

        <Entry
            x:Name="EmailEntry"
            Keyboard="Email"
            Placeholder="Email" />

        <Entry
            x:Name="SenhaEntry"
            IsPassword="True"
            Placeholder="Senha" />

        <Button
            BackgroundColor="#512BD4"
            Clicked="OnLoginClicked"
            CornerRadius="8"
            Text="Entrar"
            TextColor="White" />

        <Label
            x:Name="MensagemLabel"
            HorizontalOptions="Center"
            TextColor="Red" />

    </VerticalStackLayout>
</ContentPage>
